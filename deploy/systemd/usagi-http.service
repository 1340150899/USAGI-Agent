[Unit]
Description=USAGI HTTP application
After=network-online.target
Wants=network-online.target

[Service]
User=usagi
WorkingDirectory=/opt/usagi
EnvironmentFile=/etc/usagi/application.env
ExecStart=/opt/usagi/.venv/bin/python -m usagi_httpserver --config /opt/usagi/apps/httpserver/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=multi-user.target
