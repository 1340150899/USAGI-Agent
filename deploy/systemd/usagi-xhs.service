[Unit]
Description=Xiaohongshu MCP for USAGI
After=network-online.target
Wants=network-online.target

[Service]
User=usagi
WorkingDirectory=/opt/usagi/apps/xiaohongshu-mcp
Environment=COOKIES_PATH=/var/lib/usagi/xiaohongshu/cookies.json
StateDirectory=usagi/xiaohongshu
# Build the bundled service and complete browser login as this user first.
# A graphical desktop must be available because headless mode is prohibited.
ExecStart=/opt/usagi/apps/xiaohongshu-mcp/build/xiaohongshu-mcp -headless=false -port=:18060
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=multi-user.target
